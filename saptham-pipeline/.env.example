# SECRET NAMES ONLY — never commit real values. Copy to `.env` (git-ignored) and fill.
# The pipeline reads these via pipeline/canon/env.ts; values are never logged (only 'set'/'missing').

# --- HTTP API providers ---
PIXVERSE_API_KEY=        # PixVerse V6 direct API (secondary; also via OpenArt)
GEMINI_API_KEY=          # Google Gemini: reasoning / prompt-opt / OCR / image

# --- Local tools ---
COMFYUI_TOKEN=           # ComfyUI auth token
COMFYUI_HOST=http://127.0.0.1:8188
OLLAMA_HOST=http://127.0.0.1:11434
FFMPEG_PATH=ffmpeg       # path or command on PATH
BLENDER_PATH=blender     # path or command on PATH

# --- MCP providers (no key here) ---
# OpenArt MCP + Kling MCP authenticate via their MCP connection (OAuth/session), not env vars.
