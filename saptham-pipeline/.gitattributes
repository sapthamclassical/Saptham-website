# Large binaries tracked via Git LFS (source-of-truth artifacts + delivery).
vault/store/** filter=lfs diff=lfs merge=lfs -text
vault/assets/**/*.png  filter=lfs diff=lfs merge=lfs -text
vault/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
vault/assets/**/*.jpg  filter=lfs diff=lfs merge=lfs -text
vault/assets/**/*.mp4  filter=lfs diff=lfs merge=lfs -text
vault/delivery/**/*.png  filter=lfs diff=lfs merge=lfs -text
vault/delivery/**/*.webp filter=lfs diff=lfs merge=lfs -text
vault/delivery/**/*.mp4  filter=lfs diff=lfs merge=lfs -text

# Sidecars, cards, registry, configs stay as normal text (diff-friendly).
*.json text
*.yaml text
