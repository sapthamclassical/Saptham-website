# index.html must never be cached hard, or returning visitors get a stale build
# (this is what served the old light-theme "white" page on mobile after a deploy).
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# hashed assets are content-addressed — safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=604800
