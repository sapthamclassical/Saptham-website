# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
#
# Both values are safe to ship in the browser bundle: the publishable (anon) key
# grants exactly what the Row Level Security policies allow.
# NEVER put the service_role key here — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Database tooling only. Use either the URL or every component below. The CA
# certificate is public; download the project's certificate from Supabase and
# point this variable at the local PEM file so TLS is verified.
SUPABASE_DB_URL=
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=
SUPABASE_DB_CA_CERT=
